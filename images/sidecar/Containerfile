# =========================================================================
# llama.cpp Sidecar — ROCm build for AMD Radeon AI PRO R9700 (gfx1201)
#
# Self-contained: shallow-clones llama.cpp at a pinned commit inside the
# builder stage and compiles it against ROCm. Adapted from
# ~/Src/sourcebot/deploy/sidecar-Containerfile — the recipe that produced
# the original image (llama.cpp commit 0cea362, built 2026-07-24).
#
# GPU:   AMD Radeon AI PRO R9700 (32GB VRAM, gfx1201/RDNA4)
# Model: Qwen3.8-27B-UD-Q5_K_XL dense (vision), ~21 GB incl. mmproj
# ROCm:  7.2.1 (official rocm/dev-ubuntu-24.04:7.2.1-complete base)
#
# Build (repo root):
#   python3 run.py --build-sidecar
#   # or directly:
#   podman build -t localhost/llamacpp-sidecar:latest \
#     -f images/sidecar/Containerfile .
# =========================================================================

ARG ROCM_VERSION=7.2.1
# llama.cpp revision to build — pinned for reproducibility; bump deliberately.
# v0.1.2 (1511ce3, 2026-08-18): includes yield_to_queue thread-model redesign
# (22b8e31) that moves speculative processing to a worker thread — required for
# stable MTP + continuous batching under -np 2. Also includes 5f754ea
# (--models-dir MTP loading, additive). Previous pin 9d57ce45 predated both.
ARG LLAMA_REV=1511ce3bc3f087376c8526b4ad07100bfabb277f

# --- Builder stage ---
FROM docker.io/rocm/dev-ubuntu-24.04:${ROCM_VERSION}-complete AS builder
ARG LLAMA_REV

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    git \
    libssl-dev \
    curl \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Shallow checkout of the pinned commit (GitHub allows fetching by SHA).
RUN git init /app \
    && git -C /app remote add origin https://github.com/ggml-org/llama.cpp.git \
    && git -C /app fetch --depth 1 origin ${LLAMA_REV} \
    && git -C /app checkout FETCH_HEAD

# Build only for gfx1201 (R9700) — faster than a fat binary.
ENV AMDGPU_TARGETS=gfx1201

WORKDIR /app

RUN HIPCXX="$(hipconfig -l)/clang" HIP_PATH="$(hipconfig -R)" \
    cmake -S . -B build \
        -DGGML_HIP=ON \
        -DGGML_HIP_ROCWMMA_FATTN=ON \
        -DCMAKE_BUILD_TYPE=Release \
        -DLLAMA_CURL=OFF \
        -DLLAMA_SERVER_SSL=OFF \
        -DLLAMA_BUILD_TESTS=OFF \
        -DLLAMA_BUILD_EXAMPLES=OFF \
    && cmake --build build --config Release -j$(nproc) \
        --target llama-server llama-cli

# --- Runtime stage ---
FROM docker.io/rocm/dev-ubuntu-24.04:${ROCM_VERSION}-complete AS runtime

ENV DEBIAN_FRONTEND=noninteractive
ENV HSA_ENABLE_SDMA=0

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Copy all built artifacts (binaries + shared libs) from the build output.
COPY --from=builder /app/build/bin /opt/llama.cpp/bin
ENV LD_LIBRARY_PATH=/opt/rocm/lib:/opt/rocm/hip/lib:/opt/llama.cpp/bin
ENV PATH=/opt/rocm/bin:/opt/llama.cpp/bin:$PATH

RUN mkdir -p /models

EXPOSE 8090

ENV MODEL_PATH=/models/Qwen3.8-27B-UD-Q5_K_XL.gguf
# Native vision encoder (Qwen3.8 is a native VLM). Set MMPROJ_PATH empty to
# omit the flag and run text-only.
ENV MMPROJ_PATH=/models/mmproj-F16.gguf
# Total context pool divided across NP slots: 262144 / 2 = 131072 (128K)
# per slot — enough for light local coding work alongside Sourcebot phases
# running in parallel. Two slots cover the real contention pattern
# (Hermes + Sourcebot). Dense hybrid GDN: only 16/64 layers hold KV
# → ~4.3 GB at q4_0.
ENV CTX_SIZE=262144
# 2 parallel slots; continuous batching keeps one model copy shared by all.
ENV NP=2
# Quantized KV cache: f16 KV for the 262144-token pool needs ~17 GB on this
# GDN hybrid (16/64 KV layers); q4_0 cuts it to ~4.3 GB at negligible cost.
ENV CACHE_TYPE_K=q4_0
ENV CACHE_TYPE_V=q4_0
ENV N_GPU_LAYERS=999
ENV HOST=0.0.0.0
ENV PORT=8090
# Clean model id for OpenAI-compatible clients (else the raw GGUF path is
# served). Hermes references the model by this name (see run.py config).
ENV MODEL_ALIAS=qwen3.8-27b
# Thinking-model handling: auto = detect  tags and route them to
# reasoning_content (Thinking ON). Set REASONING_FORMAT=none to disable
# thinking and send all tokens to content (faster, weaker reasoning).
ENV REASONING_FORMAT=auto

# Sampling: GGUF metadata bakes in temp=1.0, top_p=0.95, top_k=20 (thinking
# mode per model card). llama-server's own default min_p is 0.05; the card
# says 0.0 — pin it explicitly. Instruct-mode values (temp=0.7, top_p=0.80,
# presence_penalty=1.5) are per-request only; thinking mode is the default.
ENV MIN_P=0.0
# MTP (Multi-Token Prediction) draft model for speculative decoding.
# The MTP file contains prediction heads separate from the main weights.
# Set MTP_DRAFT_PATH empty to disable MTP (the shell guard omits all flags).
ENV MTP_DRAFT_PATH=/models/mtp-Qwen3.8-27B-Q4_0.gguf
ENV SPEC_DRAFT_N_MAX=4
ENV SPEC_DRAFT_P_MIN=0.75
CMD ["sh", "-c", "llama-server \
  -m ${MODEL_PATH} \
  ${MMPROJ_PATH:+--mmproj ${MMPROJ_PATH}} \
  ${MTP_DRAFT_PATH:+--spec-draft-model ${MTP_DRAFT_PATH} --spec-type draft-mtp --spec-draft-n-max ${SPEC_DRAFT_N_MAX} --spec-draft-p-min ${SPEC_DRAFT_P_MIN}} \
  --host ${HOST} \
  --port ${PORT} \
  -ngl ${N_GPU_LAYERS} \
  -c ${CTX_SIZE} \
  -np ${NP} \
  -t 4 \
  --min-p ${MIN_P} \
  --cont-batching \
  --alias ${MODEL_ALIAS} \
  --reasoning-format ${REASONING_FORMAT} \
  --cache-type-k ${CACHE_TYPE_K} \
  --cache-type-v ${CACHE_TYPE_V} \
  --metrics \
  --props"]
