[Unit]
Description=Sourcebot e-commerce research agent

[Container]
ContainerName=sourcebot
Image=localhost/sourcebot:latest
Network=hermesnet.network
Environment=SEARXNG_URL=http://hermes-searxng:8080
Environment=TRAFILATURA_URL=http://hermes-trafilatura:8000
Environment=PLAYWRIGHT_URL=http://hermes-playwright:8001
Secret=sourcebot-zai-api-key,type=env,target=ZAI_API_KEY
Secret=sourcebot-keepa-api-key,type=env,target=KEEPA_API_KEY
Secret=sourcebot-logfire-token,type=env,target=LOGFIRE_TOKEN
Secret=dataforseo-base64,type=env,target=DATAFORSEO_BASE64
Secret=dataforseo-base64,type=env,target=DATAFORSEO_BASE64
Volume={{HOME}}/Src/sourcebot/data:/app/data
Volume={{HOME}}/Src/sourcebot/config:/app/config:ro
Memory=4g
PodmanArgs=--cpus=2
PublishPort=127.0.0.1:8181:8181

[Service]
Restart=always
TimeoutStartSec=120

[Install]
WantedBy=default.target
