[Unit]
Description=gbrain knowledge base + MCP server
After=hermes-gbrain-pg.container

[Container]
ContainerName=hermes-gbrain
Image=localhost/gbrain:latest
Network=hermesnet.network
Environment=DATABASE_HOST=hermes-gbrain-pg
Environment=DATABASE_PORT=5432
Environment=DATABASE_USER=gbrain
Environment=DATABASE_NAME=gbrain
Environment=GBRAIN_PORT=8083
Environment=GBRAIN_HOME=/root
Environment=GBRAIN_FTS_LANGUAGE=english
Environment=LLAMA_SERVER_BASE_URL=http://hermes-llama-embed:8084/v1
Environment=LLAMA_SERVER_RERANKER_BASE_URL=http://hermes-llama-rerank:8085/v1
Environment=EMBED_ALIAS=Qwen3-Embedding-4B
Environment=EMBED_DIMENSIONS=2560
Environment=RERANK_ALIAS=Qwen3-Reranker-4B
Environment=GBRAIN_EMBEDDING_MODEL=llama-server:Qwen3-Embedding-4B
Environment=GBRAIN_EMBEDDING_DIMENSIONS=2560
Environment=GBRAIN_ADMIN_BOOTSTRAP_TOKEN={{GBRAIN_ADMIN_TOKEN}}
Secret=gbrain-pg-password,type=env,target=POSTGRES_PASSWORD
Volume={{GBRAIN_DATA_DIR}}/config:/root/.gbrain:Z
Volume={{GBRAIN_DATA_DIR}}/brain:/root/brain:Z
Memory=2g
PodmanArgs=--cpus=2
PublishPort=127.0.0.1:8083:8083

[Service]
Restart=on-failure

[Install]
WantedBy=default.target
