<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.corv.hermes-pod</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>sleep 10 &amp;&amp; /opt/podman/bin/podman machine start &amp;&amp; sleep 5 &amp;&amp; /opt/podman/bin/podman pod start hermes</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/hermes-pod.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/hermes-pod.err</string>
</dict>
</plist>
