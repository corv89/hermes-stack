#!/usr/bin/env python3
"""oc - drive the shared OpenCode v2 server through its HTTP API.

One-shot or multi-turn coding tasks. Creates a session (or continues an existing
one), sends the prompt, auto-approves permission requests, waits for the agent to
finish, and prints the final reply to stdout. The session id is printed to stderr
so a follow-up turn can continue the same session.

Usage:
    oc "task description"                     # new session, one-shot
    oc --session <id> "follow-up"             # continue session <id> (multi-turn)
    oc --continue "follow-up"                 # continue the most recently updated session
    oc --model <id> [--provider <p>] "task"   # choose model for a NEW session
    oc --agent <name> "task"                  # choose agent for a NEW session (build/plan)
    oc --timeout <seconds> "task"

For an existing/continued session, change the model/agent with `ocm` (the
--model/--agent flags apply only when creating a new session).

Env (flags override):
    OPENCODE_SERVER_URL        server base url   (default http://127.0.0.1:45650)
    OPENCODE_PASSWORD / OPENCODE_SERVER_PASSWORD   basic-auth password
    OPENCODE_SERVER_USER       basic-auth user   (default opencode)
    OC_AGENT                   agent             (default build)
    OC_MODEL_PROVIDER          provider id       (default bailian-personal)
    OC_MODEL_ID                model id          (default qwen3.8-max)
    OC_TIMEOUT                 max seconds       (default 600)
    OC_NO_SSE                  set to 1 to force polling mode

The `opencode2 run --server` CLI is broken in this beta, so this drives the server
through its HTTP API directly.

Wait strategy: SSE-first. The script subscribes to /api/event (Server-Sent Events)
and reacts to session.execution.succeeded / session.execution.failed events in real
time, eliminating the blind sleep(2) polling latency. A background thread approves
permissions. If SSE is unavailable or drops repeatedly, it falls back to polling.
"""
import argparse
import base64
import http.client
import json
import os
import sys
import threading
import time
import urllib.error
import urllib.parse
import urllib.request

S = os.environ.get("OPENCODE_SERVER_URL", "http://127.0.0.1:45650").rstrip("/")
PW = os.environ.get("OPENCODE_SERVER_PASSWORD") or os.environ.get("OPENCODE_PASSWORD") or ""
USER = os.environ.get("OPENCODE_SERVER_USER", "opencode")
AUTH = base64.b64encode(f"{USER}:{PW}".encode()).decode()
AGENT = os.environ.get("OC_AGENT", "build")
MP = os.environ.get("OC_MODEL_PROVIDER", "bailian-personal")
MI = os.environ.get("OC_MODEL_ID", "qwen3.8-max")
TIMEOUT = int(os.environ.get("OC_TIMEOUT", "600"))
FORCE_POLL = os.environ.get("OC_NO_SSE", "") == "1"


# ---------------------------------------------------------------------------
# HTTP helpers
# ---------------------------------------------------------------------------

def req(method, path, body=None):
    data = json.dumps(body).encode() if body is not None else None
    r = urllib.request.Request(S + path, data=data, method=method)
    r.add_header("Authorization", f"Basic {AUTH}")
    if data:
        r.add_header("Content-Type", "application/json")
    try:
        with urllib.request.urlopen(r, timeout=30) as resp:
            raw = resp.read()
            return json.loads(raw) if raw else {}
    except urllib.error.HTTPError as e:
        raw = e.read()
        try:
            return json.loads(raw)
        except Exception:
            return {"_error": e.code, "_body": raw.decode(errors="replace")[:300]}
    except Exception as e:  # noqa: BLE001
        return {"_error": str(e)}


def as_list(payload):
    if isinstance(payload, list):
        return payload
    if isinstance(payload, dict):
        d = payload.get("data", payload)
        return d if isinstance(d, list) else []
    return []


# ---------------------------------------------------------------------------
# Permission approval
# ---------------------------------------------------------------------------

def approve_permissions(sid):
    perms = req("GET", f"/api/session/{sid}/permission")
    for p in as_list(perms):
        pid = p.get("id") or p.get("requestID")
        if not pid:
            continue
        # The reply body field is `reply` with enum once|always|reject
        # (GET /openapi.json, schema PermissionV2.Reply). "always" persists
        # the permission project-wide so later headless runs don't re-prompt.
        for body in ({"reply": "always"}, {"reply": "once"}):
            resp = req("POST", f"/api/session/{sid}/permission/{pid}/reply", body)
            if not (isinstance(resp, dict) and resp.get("_error")):
                break


# ---------------------------------------------------------------------------
# Message helpers
# ---------------------------------------------------------------------------

def messages(sid):
    return as_list(req("GET", f"/api/session/{sid}/message"))


def message_ids(sid):
    return {m.get("id") for m in messages(sid) if m.get("id")}


def assistant_text(m):
    parts = [c.get("text", "") for c in m.get("content", []) if c.get("type") == "text"]
    return "\n".join(t for t in parts if t)


def newest_assistant(msgs):
    for m in msgs:
        if m.get("type") == "assistant":
            return m
    return None


def is_terminal(m):
    """Completed and not about to run more tools.

    Intermediate assistant turns finish with 'tool-calls' (more messages to
    come); the final turn finishes with 'stop' (or another terminal reason).
    Keying on `finish` avoids returning early on an intermediate turn that
    already carries narration text but is not the final answer.
    """
    if not (m.get("time") or {}).get("completed"):
        return False
    return m.get("finish") != "tool-calls"


def final_text(msgs, seen=None):
    """Newest completed assistant message with text that isn't a pre-existing one."""
    seen = seen or set()
    for m in msgs:
        if m.get("type") != "assistant":
            continue
        if m.get("id") in seen:
            continue
        if not (m.get("time") or {}).get("completed"):
            continue
        t = assistant_text(m)
        if t:
            return t
    return None


def latest_session_id():
    rows = as_list(req("GET", "/api/session"))
    if not rows:
        return None
    return max(rows, key=lambda x: (x.get("time") or {}).get("updated", 0)).get("id")


# ---------------------------------------------------------------------------
# SSE-driven wait (primary strategy)
# ---------------------------------------------------------------------------

def sse_connect():
    """Open the SSE event stream. Returns (conn, resp)."""
    parts = urllib.parse.urlparse(S)
    conn = http.client.HTTPConnection(parts.hostname, parts.port or 45650, timeout=60)
    conn.request("GET", "/api/event", headers={
        "Authorization": f"Basic {AUTH}",
        "Accept": "text/event-stream",
    })
    resp = conn.getresponse()
    if resp.status != 200:
        conn.close()
        raise ConnectionError(f"SSE returned HTTP {resp.status}")
    return conn, resp


def parse_sse_event(lines):
    """Parse accumulated SSE lines into a JSON dict, or None."""
    data_str = None
    for line in lines:
        if line.startswith("data: "):
            data_str = line[6:]
        elif line.startswith("data:"):
            data_str = line[5:]
    if not data_str:
        return None
    try:
        return json.loads(data_str)
    except json.JSONDecodeError:
        return None


def wait_via_sse(sid, deadline):
    """Wait for session completion via SSE. Returns 'done' | 'error' | None (timeout).

    On terminal events, returns the status string. The caller then fetches
    messages to extract the final text.
    """
    result = [None]

    def on_event(evt):
        """Check if an SSE event is a terminal signal for our session."""
        evt_data = evt.get("data", {})
        if not isinstance(evt_data, dict):
            return
        if evt_data.get("sessionID") != sid:
            return
        etype = evt.get("type", "")
        if etype == "session.execution.succeeded":
            result[0] = "done"
        elif etype == "session.execution.failed":
            result[0] = "error"

    while time.time() < deadline:
        conn = None
        try:
            conn, resp = sse_connect()
            event_lines = []
            while time.time() < deadline and result[0] is None:
                raw = resp.readline()
                if not raw:
                    break  # connection closed
                line = raw.decode(errors="replace").rstrip("\r\n")
                if line == "":
                    # Event boundary
                    if event_lines:
                        evt = parse_sse_event(event_lines)
                        if evt:
                            on_event(evt)
                        event_lines = []
                elif line.startswith(":"):
                    # Heartbeat / comment
                    continue
                else:
                    event_lines.append(line)
            if result[0] is not None:
                break
            # Connection dropped — reconnect
        except Exception:
            pass
        finally:
            if conn:
                try:
                    conn.close()
                except Exception:
                    pass
        if time.time() < deadline:
            time.sleep(1)  # brief pause before reconnect

    return result[0]


# ---------------------------------------------------------------------------
# Polling fallback (secondary strategy)
# ---------------------------------------------------------------------------

def wait_via_poll(sid, seen, deadline):
    """Original sleep(2) polling loop — used as fallback when SSE is unavailable."""
    while time.time() < deadline:
        approve_permissions(sid)
        msgs = messages(sid)
        last = newest_assistant(msgs)
        if last is not None and last.get("id") not in seen and is_terminal(last):
            err = last.get("error")
            if err:
                return ("error", err)
            return ("done", None)
        time.sleep(2)
    return ("timeout", None)


# ---------------------------------------------------------------------------
# Combined wait: SSE + permission thread, with polling fallback
# ---------------------------------------------------------------------------

def wait_for_completion(sid, seen, timeout):
    """Wait for the agent to finish, print the result, and return.

    Strategy:
    1. Start a background thread that approves permissions every 2s.
    2. If SSE is available, wait for session.execution.succeeded/failed.
    3. If SSE fails, fall back to the polling loop.
    4. Once done, fetch messages and extract the final assistant text.
    """
    deadline = time.time() + timeout
    stop_flag = threading.Event()

    def approve_loop():
        while not stop_flag.is_set() and time.time() < deadline:
            try:
                approve_permissions(sid)
            except Exception:
                pass
            stop_flag.wait(2)

    perm_thread = threading.Thread(target=approve_loop, daemon=True)
    perm_thread.start()

    if FORCE_POLL:
        status, err = wait_via_poll(sid, seen, deadline)
    else:
        status = wait_via_sse(sid, deadline)
        if status is None:
            # SSE timed out without terminal event — try polling as fallback
            status_tup = wait_via_poll(sid, seen, deadline)
            status = status_tup[0] if status_tup[0] != "timeout" else None
            if status == "error":
                err = status_tup[1]
            else:
                err = None
        else:
            err = None

    stop_flag.set()

    if status is None:
        print("oc: timed out waiting for OpenCode to finish", file=sys.stderr)
        sys.exit(1)

    if status == "error":
        print(f"oc: agent error: {json.dumps(err)[:500] if err else 'unknown'}",
              file=sys.stderr)
        sys.exit(1)

    # status == 'done' — fetch and print the final text
    msgs = messages(sid)
    last = newest_assistant(msgs)
    if last is not None and last.get("id") not in seen and is_terminal(last):
        text = assistant_text(last) or final_text(msgs, seen)
    else:
        text = final_text(msgs, seen)

    if text:
        print(text)
        return
    print(f"oc: agent finished but produced no text", file=sys.stderr)
    sys.exit(1)


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

def main():
    ap = argparse.ArgumentParser(
        prog="oc",
        description="Drive the shared OpenCode v2 server (one-shot or multi-turn). "
                    "Prints the final reply to stdout and the session id to stderr.")
    ap.add_argument("task", nargs="*", help="task description / prompt")
    ap.add_argument("--session", help="continue this session id (multi-turn)")
    ap.add_argument("--continue", dest="cont", action="store_true",
                    help="continue the most recently updated session")
    ap.add_argument("--model", help="model id for a NEW session (env OC_MODEL_ID)")
    ap.add_argument("--provider", help="provider id for a NEW session (env OC_MODEL_PROVIDER)")
    ap.add_argument("--agent", help="agent for a NEW session (env OC_AGENT)")
    ap.add_argument("--timeout", type=int, help="max seconds (env OC_TIMEOUT)")
    ap.add_argument("--poll", action="store_true",
                    help="force polling mode instead of SSE (env OC_NO_SSE=1)")
    args = ap.parse_args()

    task = " ".join(args.task).strip()
    if not task:
        ap.error("a task description is required")

    timeout = args.timeout or TIMEOUT
    global FORCE_POLL
    FORCE_POLL = FORCE_POLL or args.poll

    if args.session:
        sid = args.session
        seen = message_ids(sid)
    elif args.cont:
        sid = latest_session_id()
        if not sid:
            print("oc: no session to continue", file=sys.stderr)
            sys.exit(1)
        seen = message_ids(sid)
    else:
        agent = args.agent or AGENT
        provider = args.provider or MP
        model = args.model or MI
        sess = req("POST", "/api/session", {
            "agent": agent,
            "model": {"id": model, "providerID": provider},
        })
        sid = (sess.get("data") or {}).get("id")
        if not sid:
            print(f"oc: failed to create session: {json.dumps(sess)[:300]}", file=sys.stderr)
            sys.exit(1)
        seen = set()

    print(f"[oc] session={sid}", file=sys.stderr)

    pr = req("POST", f"/api/session/{sid}/prompt", {"text": task})
    if isinstance(pr, dict) and pr.get("_error"):
        print(f"oc: prompt failed: {json.dumps(pr)[:300]}", file=sys.stderr)
        sys.exit(1)

    wait_for_completion(sid, seen, timeout)


if __name__ == "__main__":
    main()
